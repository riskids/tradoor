{
  "name": "tradoor-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "deno test --quiet",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "app js",
      "path": ["dist/assets/index-*.js", "dist/assets/web-*.js", "dist/assets/solid-*.js"],
      "limit": "49 kB"
    },
    {
      "name": "engine worker js",
      "path": "dist/assets/worker-*.js",
      "limit": "17.5 kB"
    },
    {
      "name": "engine wasm",
      "path": "dist/assets/*.wasm",
      "limit": "153 kB",
      "gzip": true
    }
  ],
  "dependencies": {
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@size-limit/file": "13.1.1",
    "size-limit": "13.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-solid": "2.11.14"
  }
}
