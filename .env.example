POSTGRES_USER=tradoor
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tradoor
DATABASE_URL=postgres://tradoor:change-me@127.0.0.1:5438/tradoor
# Where candle partitions are written and served from.
TRADOOR_DATA_DIR=./data
TRADOOR_BIND=127.0.0.1:8080

# Optional.
# Writes (drawings, workspaces) require `Authorization: Bearer <token>` when set.
# TRADOOR_API_TOKEN=
# Serve the built web app from tradoor-server instead of nginx.
# TRADOOR_WEB_DIR=./web/dist
# Seconds between recorder passes.
# TRADOOR_RECORDER_INTERVAL=600
# Binance's market-data mirror, for networks where api.binance.com is unreachable.
# BINANCE_SPOT_REST=https://data-api.binance.vision
